{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand sale tracker data",
  "type": "object",
  "required": ["title", "checked", "brands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "description": "Page heading." },
    "checked": {
      "type": "string",
      "format": "date",
      "description": "Date (YYYY-MM-DD) the brands were last checked."
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brand", "website", "status", "notes", "country", "type"],
        "additionalProperties": false,
        "properties": {
          "brand": { "type": "string", "minLength": 1 },
          "website": {
            "type": ["string", "null"],
            "pattern": "^https?://",
            "description": "Full URL of the site that was checked, or null if there is none."
          },
          "status": {
            "enum": ["live", "other_sale", "not_yet", "unknown", "closed"],
            "description": "live = Black Friday sale is live; other_sale = a non-Black-Friday sale is on; not_yet = no sale; unknown = couldn't check; closed = brand no longer operating."
          },
          "notes": { "type": "string", "description": "What was seen on the site." },
          "country": { "type": "string" },
          "type": {
            "enum": [
              "Heritage / performance",
              "Modern premium",
              "Value / mid-range",
              "Independent",
              "Custom / team kit"
            ]
          }
        }
      }
    }
  }
}
