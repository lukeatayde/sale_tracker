{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sale tracker manifest",
  "type": "object",
  "required": ["title", "tables"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "description": "Page heading." },
    "tables": {
      "type": "array",
      "description": "Table files in data/, in the order they appear on the page.",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" }
    }
  }
}
